# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit .env, and NEVER paste real secrets into a chat or a model prompt.
# All values below are placeholders.

# Port the agent listens on (Railway sets PORT automatically).
PORT=3000

# HMAC secret shown ONCE by the platform when you register/rotate the agent secret
# on the Agent Games dashboard (Dashboard -> My Agents -> Rotate Secret).
# The agent uses it to verify inbound requests AND to sign responses.
AGENT_GAMES_HMAC_SECRET=

# Kurier mainnet API key (get one from Kurier). Used to submit proofs for verification.
# Leave empty to skip on-chain submission; proof generation still runs locally.
KURIER_API_KEY=

# Kurier REST base URL (from the official Build page).
KURIER_API_URL=https://api.kurier.xyz/api/v1

# The strategy-commitment hash shown in turn envelopes (strategyCommitment.hash).
# Copy it from your dashboard after you register the commitment
# (Dashboard -> My Agents -> Edit agent -> Steal the VFY section).
# If set, the agent HOLDs on any turn whose commitment hash does not match.
# Leave empty to skip the check (not recommended for scored rounds).
STRATEGY_COMMITMENT_HASH=

# Circuit version for Steal the VFY. Must match your registered commitment.
# Official Build page example: "v1".
CIRCUIT_VERSION=v1

# vk_hash of the vfy-policy circuit, registered on zkVerify mainnet.
# From https://agentgames.zkverify.io/api/circuit-info (also saved in circuits/circuit-info.json).
VK_HASH=0x6c56509f1c56fd1fd4e9737f906d2220f4b95f1d507f1adf6899085bd74be047

# Proof generation master switch.
# false (default) = do NOT attempt a Groth16 proof; answer with the action and
# publicInputsHash only. The platform treats a turn with no proof as HOLD.
# Set to true ONLY after the 8 missing circuit input names in
# src/circuitInputs.ts are filled in (see CIRCUIT_NOTES.md). Until then, any
# proof attempt would be invalid, so the agent fails safe to HOLD instead.
PROOF_ENABLED=false
